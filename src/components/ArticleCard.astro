---
export interface Props {
  title: string;
  date: string;
  category: string;
  excerpt?: string;
  slug: string;
  readingTime?: string;
}

const { title, date, category, excerpt, slug, readingTime } = Astro.props;

const categoryColors: Record<string, string> = {
  politics: 'bg-blue-600',
  economy: 'bg-green-600',
  employment: 'bg-purple-600',
  education: 'bg-orange-600',
  international: 'bg-red-600',
  general: 'bg-gray-600'
};

const bgColor = category ? (categoryColors[category.toLowerCase()] || categoryColors.general) : categoryColors.general;

const formattedDate = new Date(date).toLocaleDateString('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<article class="article-card group">
  <div class="flex items-start gap-4">
    <div class="flex-1">
      <!-- Category Badge -->
      <span class={`category-tag ${bgColor}`}>
        {category}
      </span>

      <!-- Title -->
      <h2 class="text-2xl md:text-3xl font-bold mt-3 mb-2 leading-tight">
        <a
          href={`/articles/${slug}`}
          class="text-gray-900 hover:text-canadian-red transition-colors no-underline"
        >
          {title}
        </a>
      </h2>

      <!-- Meta Information -->
      <div class="flex items-center gap-4 text-sm text-gray-600 font-sans mb-3">
        <time datetime={date}>{formattedDate}</time>
        {readingTime && (
          <>
            <span>•</span>
            <span>{readingTime}</span>
          </>
        )}
      </div>

      <!-- Excerpt -->
      {excerpt && (
        <p class="text-gray-700 leading-relaxed mb-4">
          {excerpt}
        </p>
      )}

      <!-- Read More Link -->
      <a
        href={`/articles/${slug}`}
        class="inline-flex items-center text-canadian-red font-sans font-semibold text-sm uppercase tracking-wide hover:underline"
      >
        Read Full Analysis
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</article>
