---
import { base } from '../config';

const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-white mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- About Section -->
      <div>
        <h3 class="text-xl font-bold mb-4">stopbleeding.ca</h3>
        <p class="text-gray-400 text-sm leading-relaxed">
          AI-powered analysis of Canadian news. Data-driven insights on
          politics, economy, employment, and education.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-xl font-bold mb-4">Categories</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href={`${base}/category/politics`}
              class="text-gray-400 hover:text-white transition-colors"
              >Politics</a
            >
          </li>
          <li>
            <a
              href={`${base}/category/economy`}
              class="text-gray-400 hover:text-white transition-colors"
              >Economy</a
            >
          </li>
          <li>
            <a
              href={`${base}/category/employment`}
              class="text-gray-400 hover:text-white transition-colors"
              >Employment</a
            >
          </li>
          <li>
            <a
              href={`${base}/category/education`}
              class="text-gray-400 hover:text-white transition-colors"
              >Education</a
            >
          </li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-xl font-bold mb-4">Information</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href={`${base}/about`}
              class="text-gray-400 hover:text-white transition-colors"
              >About Us</a
            >
          </li>
          <li>
            <a
              href={`${base}/rss.xml`}
              class="text-gray-400 hover:text-white transition-colors"
              >RSS Feed</a
            >
          </li>
          <li>
            <a
              href="https://github.com/North-Atlantic-Think-Tank/vibe-stop-bleeding"
              class="text-gray-400 hover:text-white transition-colors">GitHub</a
            >
          </li>
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div
      class="border-t border-gray-800 mt-8 pt-8 text-center text-sm text-gray-400"
    >
      <p>&copy; {currentYear} stopbleeding.ca. All rights reserved.</p>
      <p class="mt-2">Powered by Claude AI and NATT.</p>
    </div>
  </div>
</footer>
