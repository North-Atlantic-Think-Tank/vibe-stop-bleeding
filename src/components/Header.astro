---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Politics', href: '/category/politics' },
  { label: 'Economy', href: '/category/economy' },
  { label: 'Employment', href: '/category/employment' },
  { label: 'Education', href: '/category/education' },
  { label: 'About', href: '/about' },
];

const currentPath = Astro.url.pathname;
---

<header class="bg-white shadow-sm border-b-2 border-canadian-red">
  <div class="max-w-7xl mx-auto sm:px-1 lg:px-2">
    <!-- Masthead -->
    <div class="py-3 flex justify-center gap-3">
      <h1 class="newspaper-header-compact">
        <a
          href="/"
          title="Canadian News Analysis"
          class="text-gray-900 no-underline hover:text-canadian-red transition-colors"
        >
          Stopbleeding Canada
        </a>
      </h1>
    </div>

    <!-- Navigation -->
    <nav class="py-3">
      <ul
        class="flex flex-wrap justify-center gap-4 md:gap-8 font-sans text-sm font-semibold uppercase tracking-wide"
      >
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class={`
                hover:text-canadian-red transition-colors
                ${currentPath === item.href ? 'text-canadian-red border-b-2 border-canadian-red' : 'text-gray-700'}
              `}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
