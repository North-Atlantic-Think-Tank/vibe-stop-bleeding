---
import RainEffect from '../components/RainEffect';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rain Effect Demo - stopbleeding.ca</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background: #0a0a0a;
        color: #ffffff;
        overflow-x: hidden;
      }

      .demo-container {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2rem;
      }

      .header {
        text-align: center;
        margin-bottom: 2rem;
        max-width: 800px;
      }

      .header h1 {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .header p {
        font-size: 1.1rem;
        color: #a0a0a0;
        line-height: 1.6;
      }

      .rain-wrapper {
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
        margin-bottom: 2rem;
      }

      .controls {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 2rem;
        max-width: 600px;
        width: 100%;
      }

      .control-group {
        margin-bottom: 1.5rem;
      }

      .control-group label {
        display: block;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
        color: #b0b0b0;
      }

      .control-group input[type="range"] {
        width: 100%;
        height: 6px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 3px;
        outline: none;
        -webkit-appearance: none;
      }

      .control-group input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 18px;
        height: 18px;
        background: #667eea;
        border-radius: 50%;
        cursor: pointer;
      }

      .control-group input[type="range"]::-moz-range-thumb {
        width: 18px;
        height: 18px;
        background: #667eea;
        border-radius: 50%;
        cursor: pointer;
        border: none;
      }

      .control-group input[type="text"] {
        width: 100%;
        padding: 0.75rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 6px;
        color: white;
        font-size: 0.95rem;
      }

      .value-display {
        display: inline-block;
        margin-left: 0.5rem;
        color: #667eea;
        font-weight: 600;
      }

      .info {
        margin-top: 2rem;
        padding: 1.5rem;
        background: rgba(102, 126, 234, 0.1);
        border: 1px solid rgba(102, 126, 234, 0.3);
        border-radius: 8px;
        max-width: 800px;
      }

      .info h3 {
        margin-bottom: 1rem;
        color: #667eea;
      }

      .info ul {
        margin-left: 1.5rem;
        line-height: 1.8;
      }

      .info li {
        color: #c0c0c0;
      }

      @media (max-width: 768px) {
        .header h1 {
          font-size: 2rem;
        }

        .demo-container {
          padding: 1rem;
        }

        .rain-wrapper {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <div class="demo-container">
      <div class="header">
        <h1>Rain & Window Effect</h1>
        <p>
          An interactive rain simulation with realistic glass distortion effects, built with React and PixiJS.
          Inspired by the Codrops rain effect experiments.
        </p>
      </div>

      <div class="rain-wrapper">
        <RainEffect
          client:load
          backgroundImage="https://images.unsplash.com/photo-1449034446853-66c86144b0ad?w=1920&q=80"
          width={800}
          height={600}
          rainIntensity={30}
        />
      </div>

      <div class="controls">
        <h2 style="margin-bottom: 1.5rem; font-size: 1.3rem;">Controls</h2>

        <div class="control-group">
          <label for="intensity">
            Rain Intensity
            <span class="value-display" id="intensity-value">30</span>
          </label>
          <input
            type="range"
            id="intensity"
            min="10"
            max="100"
            value="30"
          />
        </div>

        <div class="control-group">
          <label for="bg-image">Background Image URL</label>
          <input
            type="text"
            id="bg-image"
            value="https://images.unsplash.com/photo-1449034446853-66c86144b0ad?w=1920&q=80"
            placeholder="Enter image URL"
          />
        </div>
      </div>

      <div class="info">
        <h3>How It Works</h3>
        <ul>
          <li><strong>Raindrop Physics:</strong> Each drop has gravity, momentum, and collision detection</li>
          <li><strong>Merging Effect:</strong> Drops close to each other merge, increasing size until they fall</li>
          <li><strong>Glass Distortion:</strong> Displacement filters create realistic light refraction through water</li>
          <li><strong>Trail Effect:</strong> Drops leave semi-transparent trails as they slide down</li>
          <li><strong>Performance:</strong> Hardware-accelerated WebGL rendering via PixiJS</li>
        </ul>
      </div>
    </div>

    <script>
      // Handle intensity slider
      const intensitySlider = document.getElementById('intensity');
      const intensityValue = document.getElementById('intensity-value');

      if (intensitySlider && intensityValue) {
        intensitySlider.addEventListener('input', (e) => {
          intensityValue.textContent = (e.target as HTMLInputElement).value;
          // Note: Changing intensity requires component re-render
          // This is just for display purposes in the demo
        });
      }
    </script>
  </body>
</html>
