---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { readdir, readFile } from 'fs/promises';
import { join } from 'path';

export async function getStaticPaths() {
  const categories = ['politics', 'economy', 'employment', 'education', 'international', 'general'];

  return categories.map(category => ({
    params: { category },
  }));
}

const { category } = Astro.params;

// Function to get articles by category
async function getArticlesByCategory(categoryFilter: string) {
  try {
    const articlesDir = join(process.cwd(), 'content/articles');
    const files = await readdir(articlesDir);

    const articles = await Promise.all(
      files
        .filter(file => file.endsWith('.json'))
        .map(async (file) => {
          const filePath = join(articlesDir, file);
          const content = await readFile(filePath, 'utf-8');
          const article = JSON.parse(content);

          const excerpt = article.content
            ? article.content.split('\n\n')[0].substring(0, 200) + '...'
            : '';

          return {
            ...article,
            slug: file.replace('.json', ''),
            excerpt,
            readingTime: `${Math.ceil(article.content?.split(' ').length / 200)} min read`
          };
        })
    );

    // Filter by category and sort by date
    return articles
      .filter(article => article.category.toLowerCase() === categoryFilter.toLowerCase())
      .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
  } catch (error) {
    console.error('Error loading articles:', error);
    return [];
  }
}

const articles = await getArticlesByCategory(category!);
const categoryTitle = category!.charAt(0).toUpperCase() + category!.slice(1);

const categoryDescriptions: Record<string, string> = {
  politics: 'Analysis of Canadian federal, provincial, and municipal political developments',
  economy: 'Economic trends, GDP, inflation, and financial market analysis for Canada',
  employment: 'Canadian job market insights, unemployment rates, and workforce trends',
  education: 'Updates on Canadian education policy, funding, and institutional changes',
  international: 'Global affairs, foreign policy, and international developments affecting Canada',
  general: 'Comprehensive analysis of Canadian news and current affairs'
};

const description = categoryDescriptions[category!] || categoryDescriptions.general;
---

<BaseLayout
  title={`${categoryTitle} - stopbleeding.ca`}
  description={description}
>
  <Header />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Category Header -->
    <header class="text-center mb-12 pb-8 border-b-2 border-gray-300">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">{categoryTitle}</h1>
      <p class="text-gray-600 text-lg max-w-2xl mx-auto">
        {description}
      </p>
    </header>

    <!-- Articles List -->
    {articles.length > 0 ? (
      <div class="space-y-8">
        {articles.map((article) => (
          <ArticleCard
            title={article.title}
            date={article.date}
            category={article.category}
            excerpt={article.excerpt}
            slug={article.slug}
            readingTime={article.readingTime}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <p class="text-gray-600 text-lg">
          No {categoryTitle.toLowerCase()} articles published yet. Check back soon!
        </p>
        <a
          href="/"
          class="inline-block mt-6 text-canadian-red font-sans font-semibold hover:underline"
        >
          ← Back to Home
        </a>
      </div>
    )}
  </main>

  <Footer />
</BaseLayout>
