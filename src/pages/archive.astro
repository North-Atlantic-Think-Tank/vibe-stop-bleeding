---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { readdir, readFile } from 'fs/promises';
import { join } from 'path';
import { normalizeArticle } from '../utils/article-normalizer';

// Function to get all articles
async function getArticles() {
  try {
    const articlesDir = join(process.cwd(), 'content/articles');
    const files = await readdir(articlesDir);

    const articles = await Promise.all(
      files
        .filter((file) => file.endsWith('.json'))
        .map(async (file) => {
          const filePath = join(articlesDir, file);
          const content = await readFile(filePath, 'utf-8');
          const rawArticle = JSON.parse(content);

          // Normalize the article schema
          const article = normalizeArticle(rawArticle);

          const excerpt = article.content
            ? article.content.split('\n\n')[0].substring(0, 200) + '...'
            : '';

          return {
            ...article,
            slug: file.replace('.json', ''),
            excerpt,
            readingTime: `${Math.ceil(article.content?.split(' ').length / 200)} min read`,
          };
        }),
    );

    // Sort by date, newest first
    return articles.sort(
      (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
    );
  } catch (error) {
    console.error('Error loading articles:', error);
    return [];
  }
}

const articles = await getArticles();

// Group articles by year and month for archive display
const groupedArticles = articles.reduce(
  (acc, article) => {
    const date = new Date(article.date);
    const yearMonth = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
    if (!acc[yearMonth]) {
      acc[yearMonth] = [];
    }
    acc[yearMonth].push(article);
    return acc;
  },
  {} as Record<string, typeof articles>,
);

const sortedYearMonths = Object.keys(groupedArticles).sort((a, b) =>
  b.localeCompare(a),
);

function formatYearMonth(yearMonth: string): string {
  const [year, month] = yearMonth.split('-');
  const date = new Date(parseInt(year), parseInt(month) - 1);
  return date.toLocaleDateString('en-CA', { year: 'numeric', month: 'long' });
}
---

<BaseLayout
  title="Article Archive - stopbleeding.ca"
  description="Browse all Canadian news analysis articles from stopbleeding.ca"
>
  <Header />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Archive Header -->
    <header class="text-center mb-12 pb-8 border-b-2 border-gray-300">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Article Archive</h1>
      <p class="text-gray-600 text-lg max-w-2xl mx-auto">
        Browse all `<span class="font-bold">{articles.length}</span>` articles
        from our Canadian news analysis coverage
      </p>
    </header>

    <!-- Articles List Grouped by Month -->
    {
      sortedYearMonths.length > 0 ? (
        <div class="space-y-12">
          {sortedYearMonths.map((yearMonth) => (
            <section>
              <h2 class="text-2xl font-bold font-sans mb-6 pb-2 border-b border-gray-200">
                {formatYearMonth(yearMonth)}
              </h2>
              <div class="space-y-6">
                {groupedArticles[yearMonth].map((article) => (
                  <ArticleCard
                    title={article.title}
                    date={article.date}
                    category={article.category}
                    excerpt={article.excerpt}
                    slug={article.slug}
                    readingTime={article.readingTime}
                  />
                ))}
              </div>
            </section>
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-gray-600 text-lg">
            No articles published yet. Check back soon for Canadian news
            analysis!
          </p>
          <a
            href="/"
            class="inline-block mt-6 text-canadian-red font-sans font-semibold hover:underline"
          >
            ← Back to Home
          </a>
        </div>
      )
    }
  </main>

  <Footer />
</BaseLayout>
